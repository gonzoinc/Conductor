# Salt owns this YAML and grants the conductor service account read access.
conductor:
  service_user: conductor
  install_dir: /opt/conductor
  state_dir: /var/lib/conductor
  bind: 127.0.0.1
  port: 8012
  initial_users: [alice]
  enrollment_group: conductor-enroll
database:
  engine: sqlite
  mode: create
  path: /var/lib/conductor/tasks.sqlite3

# To use an existing shared MySQL service, replace the database mapping with:
# database:
#   engine: mysql
#   mode: existing
#   host: mysql.example.internal
#   port: 3306
#   name: conductor
#   user: conductor
#   password_file: /etc/conductor/mysql-password
#   ssl_ca: /etc/conductor/mysql-ca.pem
